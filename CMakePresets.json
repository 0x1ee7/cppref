{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Exercises (your code)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "solutions",
      "displayName": "Reference solutions",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/solutions",
      "cacheVariables": { "CPPREF_SOLUTIONS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "nativeToolOptions": ["-k", "0"] },
    { "name": "solutions", "configurePreset": "solutions" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true, "shortProgress": true },
      "execution": { "noTestsAction": "error", "jobs": 8 }
    },
    { "name": "solutions", "inherits": "dev", "configurePreset": "solutions" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "solutions",
      "steps": [
        { "type": "configure", "name": "solutions" },
        { "type": "build", "name": "solutions" },
        { "type": "test", "name": "solutions" }
      ]
    }
  ]
}
